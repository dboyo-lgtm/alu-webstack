global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    user haproxy
    group haproxy
    daemon

    # Default SSL material locations
    ca-base /etc/ssl/certs
    crt-base /etc/ssl/private

    # Default ciphers to use on SSL-enabled listening sockets.
    ssl-default-bind-ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384
    ssl-default-bind-options no-sslv3 no-tls1 no-tls11

defaults
    log     global
    mode    http
    option  httplog
    option  dontlognull
    timeout connect 5000ms
    timeout client  50000ms
    timeout server  50000ms

frontend hapr-frontend
    bind *:80
    bind *:443 ssl crt /etc/haproxy/certs/www.dboyo.tech.pem
    
    # Redirect HTTP traffic to HTTPS with a 301 Permanent Redirect
    redirect scheme https if !{ ssl_fc }
    
    default_backend hapr-backend

backend hapr-backend
    balance roundrobin
    server 7256-web-01 18.130.26.196:80 check
    server 7256-web-02 18.130.206.5:80 check
